{{- $records := slice -}}
{{- range .Site.RegularPages -}}
  {{- if and .File (hasPrefix .File.Path "linux/") (eq .Params.works_on_arm true) .Params.name -}}
    {{- $license := "opensource" -}}
    {{- if .Params.vendor -}}{{- $license = "commercial" -}}{{- end -}}
    {{- $test := dict -}}
    {{- if eq $license "opensource" -}}
      {{- $slug := .File.ContentBaseName -}}
      {{- with index $.Site.Data "test-results-index" -}}
        {{- with index . $slug -}}{{- $test = . -}}{{- end -}}
      {{- end -}}
    {{- end -}}
    {{- $id := partial "eco-dashboard/urlize_custom.html" (lower .Params.name) -}}
    {{- $parent := index $.Site.Data.category_data.subcategory_mapping (.Params.category | default "") | default "" -}}
    {{- $records = $records | append (dict "id" .File.Path "url_id" $id "slug" .File.ContentBaseName "source_path" .File.Path "title" .Params.name "description" (.Params.description | default "") "category" (.Params.category | default "") "parent_category" $parent "license" $license "metadata" .Params "test_record" $test "url" (printf "/linux/?package=%s" $id)) -}}
  {{- end -}}
{{- end -}}
{{- dict "schema_version" 1 "packages" $records | jsonify -}}
