# Example for a dedicated INTERNAL Linux host. Install and enable only after acceptance.
# /etc/arm64-opportunities/image.env must pin IMAGE to an approved immutable image ID/digest.
[Unit]
Description=Internal Linux Arm64 support opportunity batch
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/arm64-opportunities/image.env
RuntimeDirectory=arm64-opportunity-report
RuntimeDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/docker run --rm --pull=never --init --cidfile=/run/arm64-opportunity-report/container.id --read-only --cap-drop=ALL --security-opt=no-new-privileges:true --pids-limit=128 --memory=1g --cpus=2 --tmpfs=/tmp:rw,noexec,nosuid,size=128m,mode=1777 --mount=type=bind,source=/etc/arm64-opportunities/config.yaml,target=/config/config.yaml,readonly --mount=type=bind,source=/var/lib/arm64-opportunities,target=/state --env-file=/etc/arm64-opportunities/secrets.env ${IMAGE}
# Stop only the container created by this service invocation, including on timeout.
ExecStopPost=/bin/sh /usr/local/lib/arm64-opportunities/stop-container.sh /run/arm64-opportunity-report/container.id
TimeoutStartSec=10min
TimeoutStopSec=30s
Restart=no
StandardOutput=journal
StandardError=journal
