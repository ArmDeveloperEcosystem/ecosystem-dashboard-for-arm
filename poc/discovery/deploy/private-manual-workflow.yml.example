# Install only in an approved PRIVATE operations repository after host acceptance.
# The dedicated runner must not accept jobs from the public dashboard repository.
# No checkout: reviewed image, configuration and credentials are owned by the host.
name: Internal Arm64 opportunity report

on:
  workflow_dispatch:

permissions: {}

concurrency:
  group: arm64-opportunities-private-host
  cancel-in-progress: false

jobs:
  investigate:
    if: github.event.repository.private == true && github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
    environment: arm64-opportunities
    runs-on: [self-hosted, linux, ARM64, arm64-opportunities-private]
    timeout-minutes: 12
    steps:
      - name: Run the reviewed host configuration
        shell: bash
        run: |
          set -euo pipefail
          sudo -n /usr/bin/systemctl start arm64-opportunity-report.service
          printf '%s\n' 'Batch finished. Review the dated report and assessment status in the approved private report location.' >> "$GITHUB_STEP_SUMMARY"
