# Opt-in example only. Nothing in this repository installs or enables this timer.
[Unit]
Description=Weekly internal Linux Arm64 opportunity report

[Timer]
OnCalendar=Mon *-*-* 09:00:00 UTC
RandomizedDelaySec=15min
Persistent=false
Unit=arm64-opportunity-report.service

[Install]
WantedBy=timers.target
