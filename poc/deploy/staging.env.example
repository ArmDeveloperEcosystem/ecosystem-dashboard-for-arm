# Candidate environment for the independent Ubuntu 24.04 / Python 3.12 service.
# Not installed. Copy to /etc/arm-dashboard-search/staging.env with root-only
# permissions after host capacity, directory ownership and ports are verified.
# Build this catalog and the staging static site from the same reviewed revision.
ARM_SEARCH_SITE_DIR=/opt/arm-dashboard-search/current/site
ARM_SEARCH_PUBLIC_ORIGIN=https://d1jmgdpytvgwdc.cloudfront.net
ARM_SEARCH_SERVE_STATIC=false
ARM_SEARCH_DOCS_ENABLED=false

ARM_KB_SEARCH_URL=https://knowledge.armdevtechapi.com/search
# Enable only for controlled validation after checking the scoped KB contract.
# A true flag does not establish relevance acceptance or production readiness.
ARM_KB_SCOPE_CONFIRMED=false
# If required, inject ARM_KB_API_TOKEN privately; never commit the token.
