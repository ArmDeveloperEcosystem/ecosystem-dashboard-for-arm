# Add the limit zones in the existing nginx http {} block. This is a routing
# fragment, not a replacement for Arm's existing TLS/static-site configuration.
limit_req_zone $binary_remote_addr zone=arm_search_rate:10m rate=1r/s;
limit_conn_zone $binary_remote_addr zone=arm_search_connections:10m;

# Add these locations inside the existing HTTPS server for developer.arm.com.
# The API backend must be private; TLS and the static site stay on this origin.
location = /ecosystem-dashboard/api/search {
    limit_except POST { deny all; }
    client_max_body_size 8k;
    client_body_timeout 5s;
    limit_req zone=arm_search_rate burst=10 nodelay;
    limit_req_status 429;
    limit_conn arm_search_connections 8;
    limit_conn_status 503;
    proxy_http_version 1.1;
    proxy_set_header Host developer.arm.com;
    # Overwrite user-supplied forwarding headers. Configure the service launcher
    # to trust only this proxy's actual private address/CIDR when rate limiting
    # should use client addresses. Without trust, service limits use proxy IP.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_request_buffering on;
    proxy_connect_timeout 2s;
    proxy_read_timeout 15s;
    proxy_send_timeout 10s;
    proxy_pass http://127.0.0.1:8080/api/search;
    # Generic access logs can contain query-string text. Backend aggregate logs
    # provide counts, statuses, latency and fallback events without query text.
    access_log off;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
}

# Do not expose /api/docs, /api/openapi.json, /api/health or /api/ready publicly.
# The orchestrator probes /api/ready directly on the private service, with the
# public Host header. Health routes perform no provider calls.
