# Candidate unit, not installed. Confirm host capacity and port 8080 first.
# /opt/arm-dashboard-search/current contains poc/*.py, site/poc-catalog.json,
# and a Python 3.12 .venv built with poc/requirements.runtime.lock.txt.
# Keep the release root-owned, world-readable and not writable by this service.
[Unit]
Description=Arm dashboard staging search API
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
DynamicUser=yes
WorkingDirectory=/opt/arm-dashboard-search/current
EnvironmentFile=/etc/arm-dashboard-search/staging.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/opt/arm-dashboard-search/current/.venv/bin/python -m poc.serve --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=control-group
StandardOutput=journal
StandardError=journal
SyslogIdentifier=arm-dashboard-search

# Initial limits for measured staging validation, not capacity guarantees.
MemoryMax=512M
CPUQuota=200%
TasksMax=128
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
